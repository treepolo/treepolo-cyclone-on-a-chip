{
  "name": "treepolo-cyclone-on-a-chip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node dist/tests/spectral.js && node dist/tests/dycore.js && node dist/tests/moist.js && node dist/tests/regional.js && node dist/tests/replay.js && node dist/tests/axisym.js",
    "climate": "npm run build && node dist/tools/runHeldSuarez.js",
    "serve": "npm run build && node tools/serve.mjs",
    "test:gpu": "npm run build && node tools/gpuTest.mjs",
    "earth": "npm run build && node dist/tools/runEarth.js",
    "aquaplanet": "npm run build && node dist/tools/runAquaplanet.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.8.3"
  }
